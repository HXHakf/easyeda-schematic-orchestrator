{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "confirmed_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "contract_sha256",
    "actor",
    "confirmed_at"
  ],
  "additionalProperties": false
}
