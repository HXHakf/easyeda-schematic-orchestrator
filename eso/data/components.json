  "components": [
    {
      "id": "component.resistor",
      "title": "电阻",
      "version": "1.0.0",
      "status": "reference-only",
      "aliases": [
        "R",
        "resistor",
        "上拉电阻",
        "下拉电阻",
        "限流电阻",
        "采样电阻",
        "电位器"
      ],
      "subtypes": [
        "固定电阻",
        "可变电阻与电位器",
        "精密电阻",
        "电流采样电阻"
      ],
      "uses": [
        "上拉与下拉",
        "限流、分压和偏置",
        "电流采样与阻抗匹配"
      ],
      "connection_guidance": [
        "先确定串联、分压或对电源／地支路的角色，电位器核对滑动端。",
        "无极性两脚电阻仍需核对封装、阻值和器件功率，采样用途按需要采用 Kelvin 接法。"
      ],
      "selection_checks": [
        "核对容差、温漂、工作电压、连续功率和脉冲能力。",
        "检查温度降额、自热与整个分压／采样链的误差。"
      ],
      "common_mistakes": [
        "把 0Ω 当作没有电流及功率限制的理想导线。",
        "只按阻值和封装替换精密、采样或脉冲电阻。"
      ],
      "calculations": [
        {
          "expression": "P = I_rms^2 * R",
          "conditions": "阻值适用且电流波形已知。脉冲和额定电压另行核验。"
        }
      ],
      "primary_source_id": "jlc-component-resistor",
      "auxiliary_source_ids": [],
      "evidence": [
        {
          "source_id": "jlc-component-resistor",
          "section": "三、关键参数与计算边界"
        }
      ],
      "related_topics": [
        "adc-voltage-divider",
        "gpio-led-indicator"
      ],
      "rule_ids": []
    },
    {
      "id": "component.capacitor",
      "title": "电容",
      "version": "1.0.0",
      "status": "reference-only",
      "aliases": [
        "C",
        "capacitor",
        "去耦电容",
        "滤波电容",
        "电解电容",
        "MLCC",
        "陶瓷电容"
      ],
      "subtypes": [
        "陶瓷",
        "铝电解",
        "钽电容",
        "薄膜"
      ],
      "uses": [
        "去耦与储能",
        "耦合与滤波",
        "定时及补偿"
      ],
      "connection_guidance": [
        "去耦跨接对应电源与参考地，极性电容明确正负端。",
        "反馈、补偿和时钟负载电容按所属芯片应用电路连接。"
      ],
      "selection_checks": [
        "核对有效容量、直流偏压、温度、耐压和极性。",
        "按用途检查 ESR、纹波电流、漏电、自谐振和寿命。"
      ],
      "common_mistakes": [
        "用标称容量替代实际偏压下的有效容量。",
        "把同容值电容直接互换，忽略稳压器稳定性所需的 ESR 和容量范围。"
      ],
      "calculations": [
        {
          "expression": "C_eff >= delta_I * delta_t / delta_V",
          "conditions": "仅估算电容放电造成的电压变化。ESR、ESL、控制环路和实际负载波形另行评估。"
        }
      ],
      "primary_source_id": "jlc-component-capacitor",
      "auxiliary_source_ids": [],
      "evidence": [
        {
          "source_id": "jlc-component-capacitor",
          "section": "三、关键参数怎么读"
        }
      ],
      "related_topics": [],
      "rule_ids": []
    },
    {
      "id": "component.inductor",
      "title": "电感",
      "version": "1.0.0",
      "status": "reference-only",
      "aliases": [
        "L",
        "inductor",
        "功率电感",
        "射频电感",
        "扼流圈"
      ],
      "subtypes": [
        "功率储能电感",
        "信号与射频电感",
        "耦合／共模电感"
      ],
      "uses": [
        "开关电源储能",
        "滤波与谐振"
      ],
      "connection_guidance": [
        "区分储能、信号滤波与耦合绕组，耦合器件按手册核对绕组和同名端。",
        "连接方式及外围由具体电源或滤波拓扑确定。"
      ],
      "selection_checks": [
        "同时核对饱和电流、温升电流和直流偏置下的电感量。",
        "检查 DCR、频率、磁芯损耗和自谐振。"
      ],
      "common_mistakes": [
        "只比较标称电感量与一个额定电流。",
        "把共模电感当作相同感值的单路储能电感。"
      ],
      "calculations": [
        {
          "expression": "v = L * di/dt",
          "conditions": "适用于该工作点的近似线性电感模型，饱和、损耗与寄生另行评估。"
        }
      ],
      "primary_source_id": "jlc-component-inductor",
