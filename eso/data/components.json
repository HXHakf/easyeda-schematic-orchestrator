  "components": [
    {
      "id": "component.resistor",
      "title": "电阻",
      "version": "1.0.0",
      "status": "reference-only",
      "aliases": [
        "R",
        "resistor",
        "上拉电阻",
        "下拉电阻",
        "限流电阻",
        "采样电阻",
        "电位器"
      ],
      "subtypes": [
        "固定电阻",
        "可变电阻与电位器",
        "精密电阻",
        "电流采样电阻"
      ],
      "uses": [
        "上拉与下拉",
        "限流、分压和偏置",
        "电流采样与阻抗匹配"
      ],
      "connection_guidance": [
        "先确定串联、分压或对电源／地支路的角色，电位器核对滑动端。",
        "无极性两脚电阻仍需核对封装、阻值和器件功率，采样用途按需要采用 Kelvin 接法。"
      ],
      "selection_checks": [
        "核对容差、温漂、工作电压、连续功率和脉冲能力。",
        "检查温度降额、自热与整个分压／采样链的误差。"
      ],
      "common_mistakes": [
