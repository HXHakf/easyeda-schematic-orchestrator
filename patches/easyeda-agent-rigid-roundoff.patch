+// Coordinate arithmetic may associate differently across rotation and several
+// checkpoint translations. Keep every discrete field exact; tolerate only the
+// same finite raw-coordinate roundoff already used by variant provenance.
+func schematicRigidPlacementEqual(got, expected SchematicPlacement) bool {
+	near := schematicVariantNumberEqual
+	if !near(got.X, expected.X) || !near(got.Y, expected.Y) ||
+		!schematicVariantBoxEqual(got.BBox, expected.BBox) ||
+		len(got.TextBBoxes) != len(expected.TextBBoxes) || len(got.Pins) != len(expected.Pins) {
+		return false
+	}
+	got.TextBBoxes = append([]layoutBBox(nil), got.TextBBoxes...)
+	got.Pins = append([]powerLayoutPin(nil), got.Pins...)
+	for i, box := range got.TextBBoxes {
+		if !schematicVariantBoxEqual(box, expected.TextBBoxes[i]) {
+			return false
+		}
+		got.TextBBoxes[i] = expected.TextBBoxes[i]
+	}
+	for i, pin := range got.Pins {
+		if !near(pin.X, expected.Pins[i].X) || !near(pin.Y, expected.Pins[i].Y) {
+			return false
+		}
+		got.Pins[i].X, got.Pins[i].Y = expected.Pins[i].X, expected.Pins[i].Y
+	}
+	got.X, got.Y, got.BBox = expected.X, expected.Y, expected.BBox
+	return reflect.DeepEqual(got, expected)
+}
