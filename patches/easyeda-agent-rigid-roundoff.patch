+package app
+
+import (
+	"math"
+	"reflect"
+	"testing"
+)
+
+func TestOptimizationRigidEvidenceToleratesOnlyCoordinateRoundoff(t *testing.T) {
+	for _, change := range []string{"roundoff", "shape", "pin-net", "text", "mirror", "value"} {
+		t.Run(change, func(t *testing.T) {
+			in := standaloneLayoutFixture()
+			out, err := PlanSchematicLayout(in)
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, allowed, err := schematicOptimizationSettings(in)
+			if err != nil {
+				t.Fatal(err)
+			}
+			c := &out.Placements[1]
+			switch change {
+			case "roundoff":
+				c.BBox.MaxX += 1e-12
+			case "shape":
+				c.BBox.MaxX += 1e-4
+			case "pin-net":
+				c.Pins[0].Net = "CHANGED"
+			case "text":
+				c.TextBBoxes = append(c.TextBBoxes, layoutBBox{1000, 1000, 1010, 1010})
+			case "mirror":
+				c.Mirror = !c.Mirror
+			case "value":
+				c.Value = "CHANGED"
+			}
+			err = validateSchematicOptimizationEvidence(in, out, allowed)
+			if change == "roundoff" && err != nil {
+				t.Fatal(err)
+			}
+			if change != "roundoff" && err == nil {
+				t.Fatal("real mutation accepted", change)
+			}
+		})
+	}
+}
+
+func TestRigidPlacementCoordinateToleranceAndExactPinMetadata(t *testing.T) {
+	original := standaloneLayoutFixture().Components[1].Measurement
+	original.TextBBoxes = []layoutBBox{{100.1, 110.2, 120.3, 130.4}}
+	for _, change := range []string{"pin-roundoff", "text-roundoff", "pin-drift", "text-drift", "nan", "infinity", "pin-number", "pin-direction", "pin-coverage"} {
+		t.Run(change, func(t *testing.T) {
+			got := plTranslate(original, 0, 0)
+			switch change {
+			case "pin-roundoff":
+				got.Pins[0].X += 1e-12
+			case "text-roundoff":
+				got.TextBBoxes[0].MinX += 1e-12
+			case "pin-drift":
+				got.Pins[0].X += 2e-7
+			case "text-drift":
+				got.TextBBoxes[0].MinX += 2e-7
+			case "nan":
+				got.X = math.NaN()
+			case "infinity":
+				got.BBox.MaxX = math.Inf(1)
+			case "pin-number":
+				got.Pins[0].Number = "other"
+			case "pin-direction":
+				got.Pins[0].Rotation = directionNumber(90)
+			case "pin-coverage":
+				got.Pins = got.Pins[:1]
+			}
+			before := plTranslate(got, 0, 0)
+			pass := schematicRigidPlacementEqual(got, original)
+			if pass != (change == "pin-roundoff" || change == "text-roundoff") {
+				t.Fatal("wrong comparison", change)
+			}
+			if change != "nan" && !reflect.DeepEqual(got, before) {
+				t.Fatal("input mutated")
+			}
+		})
+	}
+}
+
+func TestRigidPlacementRepeatedRotationTranslationRoundoff(t *testing.T) {
+	original := SchematicPlacement{Designator: "R1", X: 0, Y: 0, BBox: layoutBBox{0.1, 0.1, 0.2, 0.2},
+		Pins:       []SchematicPin{{Number: "1", X: 0.1, Y: 0.1}, {Number: "2", X: 0.2, Y: 0.1}},
+		TextBBoxes: []layoutBBox{{0.1, 0.3, 0.2, 0.4}}}
+	turned := plRotate(original, 1)
+	got := plTranslate(plTranslate(turned, 0.2, 0.2), 0.3, 0.3)
+	expected := plTranslate(turned, got.X-original.X, got.Y-original.Y)
+	if reflect.DeepEqual(got, expected) {
+		t.Fatal("fixture must exercise floating point association")
+	}
+	if !schematicRigidPlacementEqual(got, expected) {
+		t.Fatal("legal repeated rigid transform refused")
+	}
+}
